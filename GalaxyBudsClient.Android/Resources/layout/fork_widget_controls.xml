<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: all-in-one controls widget (see Fork/README.md). RemoteViews: only framework layouts/views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/fork_controls_root"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@drawable/fork_widget_background"
              android:gravity="center_vertical"
              android:orientation="vertical"
              android:paddingStart="16dp"
              android:paddingTop="12dp"
              android:paddingEnd="12dp"
              android:paddingBottom="12dp">

    <!-- Header: device, status, connect/disconnect -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/fork_ic_buds"
            android:tint="@color/fork_widget_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fork_controls_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/fork_default_device_name"
                android:textColor="@color/fork_widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fork_controls_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/fork_status_disconnected"
                android:textColor="@color/fork_widget_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- TextView, not Button: no elevation shadow -->
        <TextView
            android:id="@+id/fork_controls_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/fork_widget_button_background"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/fork_action_connect"
            android:textColor="@color/fork_widget_button_text"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Battery: L / R / Case -->
    <LinearLayout
        android:id="@+id/fork_controls_battery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fork_battery_l"
                android:textColor="@color/fork_widget_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/fork_controls_battery_l_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/fork_widget_battery_progress" />

            <TextView
                android:id="@+id/fork_controls_battery_l_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="30dp"
                android:text="@string/fork_battery_unknown"
                android:textColor="@color/fork_widget_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fork_battery_r"
                android:textColor="@color/fork_widget_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/fork_controls_battery_r_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/fork_widget_battery_progress" />

            <TextView
                android:id="@+id/fork_controls_battery_r_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="30dp"
                android:text="@string/fork_battery_unknown"
                android:textColor="@color/fork_widget_text"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fork_controls_battery_c"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fork_battery_c"
                android:textColor="@color/fork_widget_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/fork_controls_battery_c_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/fork_widget_battery_progress" />

            <TextView
                android:id="@+id/fork_controls_battery_c_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="30dp"
                android:text="@string/fork_battery_unknown"
                android:textColor="@color/fork_widget_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Noise control: circles on a track (4 columns, or 3 without Adaptive) -->
    <FrameLayout
        android:id="@+id/fork_controls_modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <!-- Track from the first to the last circle centre: side weights 1, middle 2 * (columns - 1) -->
        <LinearLayout
            android:id="@+id/fork_controls_track_4"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="6"
                         android:background="@drawable/fork_widget_mode_track" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fork_controls_track_3"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4"
                         android:background="@drawable/fork_widget_mode_track" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/fork_controls_track_2"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2"
                         android:background="@drawable/fork_widget_mode_track" />
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/fork_controls_mode_off"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/fork_controls_mode_off_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/fork_widget_mode_circle"
                    android:contentDescription="@string/fork_nc_off"
                    android:padding="10dp"
                    android:src="@drawable/fork_ic_nc_off"
                    android:tint="@color/fork_widget_mode_icon" />

                <TextView
                    android:id="@+id/fork_controls_mode_off_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_horizontal"
                    android:maxLines="2"
                    android:text="@string/fork_nc_off"
                    android:textColor="@color/fork_widget_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fork_controls_mode_ambient"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/fork_controls_mode_ambient_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/fork_widget_mode_circle"
                    android:contentDescription="@string/fork_nc_ambient"
                    android:padding="10dp"
                    android:src="@drawable/fork_ic_nc_ambient"
                    android:tint="@color/fork_widget_mode_icon" />

                <TextView
                    android:id="@+id/fork_controls_mode_ambient_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_horizontal"
                    android:maxLines="2"
                    android:text="@string/fork_nc_ambient"
                    android:textColor="@color/fork_widget_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fork_controls_mode_adaptive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/fork_controls_mode_adaptive_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/fork_widget_mode_circle"
                    android:contentDescription="@string/fork_nc_adaptive"
                    android:padding="10dp"
                    android:src="@drawable/fork_ic_nc_adaptive"
                    android:tint="@color/fork_widget_mode_icon" />

                <TextView
                    android:id="@+id/fork_controls_mode_adaptive_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_horizontal"
                    android:maxLines="2"
                    android:text="@string/fork_nc_adaptive"
                    android:textColor="@color/fork_widget_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fork_controls_mode_anc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/fork_controls_mode_anc_icon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/fork_widget_mode_circle"
                    android:contentDescription="@string/fork_nc_anc"
                    android:padding="10dp"
                    android:src="@drawable/fork_ic_nc_anc"
                    android:tint="@color/fork_widget_mode_icon" />

                <TextView
                    android:id="@+id/fork_controls_mode_anc_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_horizontal"
                    android:maxLines="2"
                    android:text="@string/fork_nc_anc"
                    android:textColor="@color/fork_widget_text"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
