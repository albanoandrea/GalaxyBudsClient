<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: one-row controls widget (3x1 / 4x1). Same view ids as fork_widget_controls, minus the labels. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/fork_controls_root"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@drawable/fork_widget_background"
              android:gravity="center"
              android:orientation="vertical"
              android:paddingStart="12dp"
              android:paddingTop="6dp"
              android:paddingEnd="12dp"
              android:paddingBottom="8dp">

    <!-- Status or battery, very small -->
    <TextView
        android:id="@+id/fork_controls_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:text="@string/fork_status_disconnected"
        android:textColor="@color/fork_widget_text_secondary"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/fork_controls_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/fork_widget_mode_circle"
            android:contentDescription="@string/fork_action_connect"
            android:padding="9dp"
            android:src="@drawable/fork_ic_bluetooth_off"
            android:tint="@color/fork_widget_mode_icon" />

        <FrameLayout
            android:layout_width="2dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/fork_widget_mode_track" />

        <LinearLayout
            android:id="@+id/fork_controls_modes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/fork_controls_mode_off"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/fork_controls_mode_off_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/fork_widget_mode_circle"
                    android:contentDescription="@string/fork_nc_off"
                    android:padding="8dp"
                    android:src="@drawable/fork_ic_nc_off"
                    android:tint="@color/fork_widget_mode_icon" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fork_controls_mode_ambient"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/fork_controls_mode_ambient_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/fork_widget_mode_circle"
                    android:contentDescription="@string/fork_nc_ambient"
                    android:padding="8dp"
                    android:src="@drawable/fork_ic_nc_ambient"
                    android:tint="@color/fork_widget_mode_icon" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fork_controls_mode_adaptive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/fork_controls_mode_adaptive_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/fork_widget_mode_circle"
                    android:contentDescription="@string/fork_nc_adaptive"
                    android:padding="8dp"
                    android:src="@drawable/fork_ic_nc_adaptive"
                    android:tint="@color/fork_widget_mode_icon" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fork_controls_mode_anc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/fork_controls_mode_anc_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/fork_widget_mode_circle"
                    android:contentDescription="@string/fork_nc_anc"
                    android:padding="8dp"
                    android:src="@drawable/fork_ic_nc_anc"
                    android:tint="@color/fork_widget_mode_icon" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
