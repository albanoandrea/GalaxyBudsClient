<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: connect widget (see Fork/README.md). RemoteViews: only framework layouts/views. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/fork_widget_root"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@drawable/fork_widget_background"
              android:gravity="center_vertical"
              android:orientation="horizontal"
              android:padding="12dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/fork_ic_buds"
        android:tint="@color/fork_widget_text" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fork_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/fork_default_device_name"
            android:textColor="@color/fork_widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fork_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/fork_status_disconnected"
            android:textColor="@color/fork_widget_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/fork_widget_button"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:background="@drawable/fork_widget_button_background"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/fork_action_connect"
        android:textAllCaps="false"
        android:textColor="@color/fork_widget_button_text"
        android:textSize="14sp" />
</LinearLayout>
