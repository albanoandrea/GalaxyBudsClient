<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: native settings screen (no Avalonia). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:id="@+id/fork_settings_root"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="24dp"
              android:background="@color/fork_settings_background">

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="24dp"
      android:text="@string/fork_settings_title"
      android:textColor="@color/fork_settings_text"
      android:textSize="24sp"
      android:textStyle="bold" />

  <Switch
      android:id="@+id/fork_settings_auto_connect"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="48dp"
      android:text="@string/fork_settings_auto_connect"
      android:textColor="@color/fork_settings_text"
      android:textSize="16sp" />

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/fork_settings_auto_connect_desc"
      android:textColor="@color/fork_settings_text_secondary"
      android:textSize="14sp" />
</LinearLayout>
