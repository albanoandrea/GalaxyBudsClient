<Project>
  <!--
    Fork-specific Android settings (new file, never conflicts with upstream).
    Imported automatically by MSBuild before GalaxyBudsClient.Android.csproj.

    NoDemo=true selects the "full" icons/branding in the upstream csproj.
    The remaining overrides live in Directory.Build.targets (imported after the csproj).
  -->
  <PropertyGroup>
    <NoDemo>true</NoDemo>
    <!--
      Fork/ForkDispatcherImpl.cs implements Avalonia's [PrivateApi] IDispatcherImpl, which the Avalonia ref assemblies
      mark as not implementable. This compiles against the real Avalonia assemblies instead (warning AVA3001).
      Re-check ForkDispatcherImpl on every Avalonia upgrade.
    -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
  </PropertyGroup>
</Project>
